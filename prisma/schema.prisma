generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Model {
  id           Int        @id @default(autoincrement())
  level        ModelLevel
  number       Int
  code         String     @unique
  title        String     @default("")
  nationality  String     @default("")
  city         String     @default("")
  age          Int        @default(18)
  height       Int        @default(160)
  weight       Int        @default(50)
  languages    String     @default("")
  services     String     @default("")
  avatar       String     @default("")
  gallery      String     @default("")
  videos       String     @default("")
  introduction String     @default("")
  online       Boolean    @default(true)
  featured     Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model WebsiteSettings {
  id                  Int      @id @default(1)
  siteName            String   @default("ChaYanLongGong")
  logo                String   @default("")
  whatsapp            String   @default("")
  telegram            String   @default("")
  signal              String   @default("")
  line                String   @default("")
  wechatQr            String   @default("")
  email               String   @default("")
  enableWhatsApp      Boolean  @default(true)
  enableTelegram      Boolean  @default(true)
  enableSignal        Boolean  @default(false)
  enableLine          Boolean  @default(false)
  enableWechat        Boolean  @default(false)
  enableFeedbackEmail Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  favicon             String   @default("")
}

model AdminUser {
  id                  Int       @id @default(autoincrement())
  username            String    @unique
  password            String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  twoFactorEnabled    Boolean   @default(false)
  twoFactorSecret     String?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  sessions            Session[]
}

model Session {
  id             String    @id @default(cuid())
  token          String    @unique
  adminUserId    Int
  expiresAt      DateTime  @db.Timestamp(6)
  lastActivityAt DateTime  @default(now()) @db.Timestamp(6)
  ip             String?
  userAgent      String?
  createdAt      DateTime  @default(now()) @db.Timestamp(6)
  updatedAt      DateTime  @default(now()) @updatedAt @db.Timestamp(6)
  adminUser      AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([adminUserId])
  @@index([expiresAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String
  entity      String?
  entityId    String?
  userId      String?
  description String
  metadata    String?
  createdAt   DateTime @default(now())

  @@index([action])
  @@index([entity])
  @@index([userId])
  @@index([createdAt])
}

model AnalyticsVisit {
  id        Int      @id @default(autoincrement())
  path      String
  visitorId String
  ip        String?
  userAgent String?
  referrer  String?
  country   String?
  device    String?
  browser   String?
  createdAt DateTime @default(now()) @db.Timestamp(6)

  @@index([createdAt])
  @@index([path])
  @@index([visitorId])
}

model BackupRecord {
  id          String   @id @default(cuid())

  filename    String
  type        String
  size        Int

  filePath    String   @default("")
  checksum    String   @default("")

  status      String   @default("Completed")

  restoredAt  DateTime?
  restoredBy  String?

  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([status])
}

model BackupScheduler {
  id         Int      @id @default(1)

  enabled    Boolean  @default(false)
  day        String   @default("Sunday")
  time       String   @default("03:00")
  retention  Int      @default(8)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum ModelLevel {
  CROWN
  SSS
  SS
  S
  A
}