generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Model {
  id               Int        @id @default(autoincrement())
  level            ModelLevel
  number           Int
  code             String     @unique
  title            String     @default("")
  nationality      String     @default("")
  city             String     @default("")
  age              Int        @default(18)
  height           Int        @default(160)
  weight           Int        @default(50)
  languages        String     @default("")
  services         String     @default("")
  avatar           String     @default("")
  gallery          String     @default("")
  videos           String     @default("")
  introduction     String     @default("")
  online           Boolean    @default(true)
  featured         Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  introductionEn   String     @default("")
  introductionZhTW String     @default("")
  introductionZhCN String     @default("")
  introductionJa   String     @default("")
  introductionKo   String     @default("")
}

model WebsiteSettings {
  id                       Int      @id @default(1)
  siteName                 String   @default("ChaYanLongGong")
  logo                     String   @default("")
  whatsapp                 String   @default("")
  telegram                 String   @default("")
  signal                   String   @default("")
  line                     String   @default("")
  wechatQr                 String   @default("")
  email                    String   @default("")
  enableWhatsApp           Boolean  @default(true)
  enableTelegram           Boolean  @default(true)
  enableSignal             Boolean  @default(false)
  enableLine               Boolean  @default(false)
  enableWechat             Boolean  @default(false)
  enableFeedbackEmail      Boolean  @default(true)
  enableChineseTraditional Boolean  @default(true)
  enableChineseSimplified  Boolean  @default(true)
  enableJapanese           Boolean  @default(true)
  enableKorean             Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  favicon                  String   @default("")
}

model AdminUser {
  id                  Int       @id @default(autoincrement())
  username            String    @unique
  password            String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  twoFactorEnabled    Boolean   @default(false)
  twoFactorSecret     String?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  sessions            Session[]
}

model Session {
  id             String    @id @default(cuid())
  token          String    @unique
  adminUserId    Int
  expiresAt      DateTime  @db.Timestamp(6)
  lastActivityAt DateTime  @default(now()) @db.Timestamp(6)
  ip             String?
  userAgent      String?
  createdAt      DateTime  @default(now()) @db.Timestamp(6)
  updatedAt      DateTime  @default(now()) @updatedAt @db.Timestamp(6)
  adminUser      AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([adminUserId])
  @@index([expiresAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String
  entity      String?
  entityId    String?
  userId      String?
  description String
  metadata    String?
  createdAt   DateTime @default(now())

  @@index([action])
  @@index([entity])
  @@index([userId])
  @@index([createdAt])
}

model SecurityEvent {
  id          String                @id @default(cuid())
  type        SecurityEventType
  severity    SecurityEventSeverity
  status      SecurityEventStatus   @default(OPEN)
  ip          String?
  country     String?
  userAgent   String?
  adminUserId Int?
  description String
  metadata    String?
  createdAt   DateTime              @default(now())
  resolvedAt  DateTime?

  @@index([type])
  @@index([severity])
  @@index([status])
  @@index([ip])
  @@index([adminUserId])
  @@index([createdAt])
}

model AnalyticsVisit {
  id        Int      @id @default(autoincrement())
  path      String
  visitorId String
  ip        String?
  userAgent String?
  referrer  String?
  country   String?
  device    String?
  browser   String?
  createdAt DateTime @default(now()) @db.Timestamp(6)

  @@index([createdAt])
  @@index([path])
}

model BackupRecord {
  id         String    @id @default(cuid())
  filename   String
  type       String
  size       Int
  status     String    @default("Completed")
  createdAt  DateTime  @default(now())
  checksum   String    @default("")
  filePath   String    @default("")
  restoredAt DateTime?
  restoredBy String?

  @@index([createdAt])
  @@index([status])
}

model BackupScheduler {
  id        Int       @id @default(1)
  enabled   Boolean   @default(false)
  day       String    @default("Sunday")
  time      String    @default("03:00")
  retention Int       @default(8)
  lastRunAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model FirewallBlock {
  id        String            @id @default(cuid())
  type      FirewallBlockType
  value     String            @unique
  enabled   Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([type])
  @@index([enabled])
}

enum ModelLevel {
  CROWN
  SSS
  SS
  S
  A
}

enum FirewallBlockType {
  IP
  COUNTRY
}

enum SecurityEventType {
  LOGIN_FAILED
  ACCOUNT_LOCKED
  INVALID_2FA
  TWO_FACTOR_RATE_LIMITED
  FIREWALL_BLOCKED
  RATE_LIMIT_EXCEEDED
  SUSPICIOUS_SESSION
  UNAUTHORIZED_ACCESS
  SENSITIVE_ACTION
}

enum SecurityEventSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SecurityEventStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}